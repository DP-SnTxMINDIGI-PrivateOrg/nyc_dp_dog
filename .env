# ---------------------------------------------------------------------------
# NYC Dog-License DP POC — all runtime configuration. Change values here only;
# no code edits are needed for any of these tweaks.
# ---------------------------------------------------------------------------

# Path to the NYC Dog Licensing CSV inside the container (bind-mounted).
CSV_PATH=/data/nyc_dog_licenses.csv

# --- Privacy budget (Decision 6) -------------------------------------------
# Lifetime budget for the whole Session and per-question spend.
# 3 questions x 0.5 = 1.5 spent of 3.0; the rest is demo headroom, not a
# production recommendation.
DP_TOTAL_EPSILON=3.0
DP_PER_QUERY_EPSILON=0.5

# --- Transparency toggle (Decision 7) --------------------------------------
# Print the exact answer next to the DP answer. ONLY safe because this dataset
# is public. Set to false for any confidential data.
SHOW_EXACT=true

# --- Q1: filter().count() --------------------------------------------------
Q1_BREED=CHIHUAHUA
Q1_ZIP=10022

# --- Q3: filter().groupby().count() ----------------------------------------
# The dataset has no borough column; a borough is a public list of ZIP codes.
Q3_BOROUGH=Queens
Q3_ZIPS=11004,11005,11101,11102,11103,11104,11105,11106,11109,11351,11354,11355,11356,11357,11358,11359,11360,11361,11362,11363,11364,11365,11366,11367,11368,11369,11370,11372,11373,11374,11375,11377,11378,11379,11385,11411,11412,11413,11414,11415,11416,11417,11418,11419,11420,11421,11422,11423,11426,11427,11428,11429,11432,11433,11434,11435,11436,11691,11692,11693,11694,11697