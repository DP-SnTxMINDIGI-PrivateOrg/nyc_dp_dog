# # ---------------------------------------------------------------------------
# # NYC Dog-License DP POC — all runtime configuration. 
# # ---------------------------------------------------------------------------

# # Path to the NYC Dog Licensing CSV inside the container (bind-mounted).
# CSV_PATH=/data/nyc_dog_licenses.csv

# # --- Privacy budget  -------------------------------------------
# # Lifetime budget for the whole Session and per-question spend.
# # 3 questions x 0.5 = 1.5 spent of 3.0; the rest is demo headroom, not a
# # production recommendation.
# DP_TOTAL_EPSILON=3.0
# # DP_PER_QUERY_EPSILON=0.5
# # DP_PER_QUERY_EPSILON=0.001
# # DP_PER_QUERY_EPSILON=0.15
# DP_PER_QUERY_EPSILON=0.0001


# # --- Transparency toggle  --------------------------------------
# # Print the exact answer next to the DP answer. ONLY safe because this dataset
# # is public. Set to false for any confidential data.
# SHOW_EXACT=true

# # --- Q1: filter().count() --------------------------------------------------
# Q1_BREED=CHIHUAHUA
# Q1_ZIP=10022

# # --- Q3: filter().groupby().count() ----------------------------------------
# # The dataset has no borough column; a borough is a public list of ZIP codes.
# Q3_BOROUGH=Queens
# Q3_ZIPS=11004,11005,11101,11102,11103,11104,11105,11106,11109,11351,11354,11355,11356,11357,11358,11359,11360,11361,11362,11363,11364,11365,11366,11367,11368,11369,11370,11372,11373,11374,11375,11377,11378,11379,11385,11411,11412,11413,11414,11415,11416,11417,11418,11419,11420,11421,11422,11423,11426,11427,11428,11429,11432,11433,11434,11435,11436,11691,11692,11693,11694,11697

# Docker path; locally use ./data/nyc_dog_licenses.csv.
CSV_PATH=/data/nyc_dog_licenses.csv
CSV_SEP=;
DATE_FORMAT=MM/dd/yyyy
SPARK_MASTER=local[2]

# all = original Q1-Q3 + one question for each of 10 categories (Q4-Q13).
# Or comma-separated IDs, for example: 1,2,3 or 4,5,6.
RUN_QUESTIONS=all
# DP_PER_QUERY_EPSILON=0.5
# DP_PER_QUERY_EPSILON=0.25
# DP_PER_QUERY_EPSILON=0.1
DP_PER_QUERY_EPSILON=0.05
DP_TOTAL_EPSILON=13
# auto = selected-question count times DP_PER_QUERY_EPSILON.
# Example: all 13 questions at epsilon 1 require total epsilon 13.
# This is a teaching allocation, NOT a recommended ministry release budget.

# Original Q1-Q3.
Q1_BREED=CHIHUAHUA
Q1_ZIP=10022
Q3_BOROUGH=Queens
Q3_ZIPS=11004,11005,11101,11102,11103,11104,11105,11106,11109,11351,11354,11355,11356,11357,11358,11359,11360,11361,11362,11363,11364,11365,11366,11367,11368,11369,11370,11372,11373,11374,11375,11377,11378,11379,11385,11411,11412,11413,11414,11415,11416,11417,11418,11419,11420,11421,11422,11423,11426,11427,11428,11429,11432,11433,11434,11435,11436,11691,11692,11693,11694,11697

# PUBLIC candidate domains. Do not discover these from confidential input.
PUBLIC_NAMES=BELLA,MAX,CHARLIE,COCO,LOLA,LUCKY,ROCKY,BUDDY,PRINCESS,LUCY,DAISY,TEDDY,LILY,GINGER,MOLLY,JACK,TOBY,BAILEY,ANGEL,ZEUS
PUBLIC_BREEDS=YORKSHIRE TERRIER,SHIH TZU,CHIHUAHUA,MALTESE,LABRADOR RETRIEVER,PIT BULL,GERMAN SHEPHERD DOG,POODLE,BEAGLE,DACHSHUND,GOLDEN RETRIEVER,COCKER SPANIEL,PUG,BOXER,HAVANESE,FRENCH BULLDOG,BICHON FRISE,MALTESE CROSS,AMERICAN PIT BULL TERRIER/PIT BULL,MIXED/OTHER

# Q5: every nonlisted or missing gender enters the other bucket.
PUBLIC_GENDERS=M,F
GENDER_OTHER_BUCKET=OTHER

# Q6-Q9 and Q13: fixed public bounds, never raw private min/max.
AGE_LOW=0
AGE_HIGH=25
# Q8: 0.5 = median; change to 0.9 for 90th percentile.
AGE_QUANTILE=0.5
# Q10.
TOP_K=5
# Q11: null/blank is automatically unknown as well.
UNKNOWN_BREED_VALUES=UNKNOWN,UNKNOWN BREED
# Q12: inclusive window, plus OTHER and MISSING.
ISSUE_YEAR_START=2014
ISSUE_YEAR_END=2026

# Optional fixed extract filter; empty = all extracts, NOT deduplicated.
EXTRACT_YEAR_FILTER=
# Stability threshold for Q11 and Q13 noisy denominators.
MIN_NOISY_DENOMINATOR=10

# Enable BOTH only for already-public input; exact outputs bypass DP.
PUBLIC_DATA=true
SHOW_EXACT=true
# Enable tracebacks only inside a trusted execution environment.
TRUSTED_DEBUG=false